{
  "name": "@linear/cli",
  "description": "CLI interface for Linear",
  "version": "0.0.0",
  "private": true,
  "author": "Linear Orbit, Inc.",
  "main": "dist/index.js",
  "scripts": {
    "build:cli": "shx rm -rf dist tsconfig.tsbuildinfo && npx tsc -b",
    "postpack": "shx rm -f oclif.manifest.json",
    "prepack": "oclif manifest && oclif readme",
    "version": "oclif readme && git add README.md",
    "generate:cli": "npx graphql-codegen --config codegen.cli.yml"
  },
  "bin": {
    "linear": "./bin/run.js"
  },
  "dependencies": {
    "@mishieck/ink-titled-box": "^0.3.0",
    "@oclif/core": "4",
    "@oclif/plugin-autocomplete": "^3.2.39",
    "@oclif/plugin-help": "6",
    "@oclif/plugin-plugins": "5",
    "date-fns": "^4.1.0",
    "dotenv": "6.2.0",
    "eventsource-parser": "^3.0.6",
    "ink": "^6.5.0",
    "ink-link": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "ink-table": "^3.1.0",
    "ink-text-input": "^6.0.0",
    "lodash.set": "^4.3.2",
    "marked": "^17.0.0",
    "marked-terminal": "^7.3.0",
    "open": "10.2.0",
    "react": "^19.2.0",
    "terminal-link": "5.0.0",
    "undici": "7.16.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/dotenv": "4.0.3",
    "@types/lodash.set": "^4.3.9",
    "@types/marked": "^6.0.0",
    "@types/marked-terminal": "^6.1.1",
    "oclif": "4",
    "shx": "0.3.3",
    "ts-node": "10.9.2"
  },
  "engines": {
    "node": ">=22.20"
  },
  "files": [
    "README.md",
    "./bin",
    "./dist",
    "./oclif.manifest.json",
    "./theme.json"
  ],
  "homepage": "https://github.com/linear/linear-app",
  "keywords": [
    "oclif"
  ],
  "oclif": {
    "bin": "linear",
    "dirname": "linear",
    "commands": {
      "strategy": "explicit",
      "target": "./dist/commands/index.js",
      "identifier": "COMMANDS"
    },
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-autocomplete"
    ],
    "theme": "./theme.json",
    "topicSeparator": " ",
    "topics": {
      "auth": {
        "description": "Authenticate with Linear"
      },
      "comment": {
        "description": "Manage comments on issues and documents"
      },
      "cycle": {
        "description": "Manage cycles and their issues"
      },
      "document": {
        "description": "Manage documents and their comments"
      },
      "initiative": {
        "description": "Manage initiatives and their content"
      },
      "initiative-update": {
        "description": "Manage initiative updates and comments"
      },
      "issue": {
        "description": "Manage issues and their attachments"
      },
      "organization": {
        "description": "View and manage organization settings"
      },
      "project": {
        "description": "Manage projects and their comments"
      },
      "project-status": {
        "description": "Manage project statuses"
      },
      "project-update": {
        "description": "Manage project updates and comments"
      },
      "roadmap": {
        "description": "Manage roadmaps"
      },
      "team": {
        "description": "Manage teams and their cycles"
      },
      "user": {
        "description": "View and manage user information and assignments"
      },
      "viewer": {
        "description": "View information about the current user"
      }
    },
    "hooks": {
      "init": "./dist/hooks/init/dotenv"
    }
  },
  "repository": "linear/linear-app",
  "types": "dist/index.d.ts",
  "type": "module"
}
